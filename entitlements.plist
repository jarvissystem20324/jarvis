<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the hardened runtime, which Apple requires before it will
  notarize anything.

  The two "cs" entitlements below look alarming and are worth understanding
  rather than copying blindly. CPython generates and executes code at runtime,
  and PyInstaller ships dozens of .dylib files that carry someone else's
  signature (or none). Under the hardened runtime both are refused by default,
  and the app dies on launch with a code-signing error. Every notarized
  PyInstaller app needs these; they widen what this process may do to itself,
  not what it may do to your machine.

  Audio input is declared so the microphone works; the human-readable reason
  shown in the prompt lives in Info.plist.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
