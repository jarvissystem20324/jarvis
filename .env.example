# Copy to .env and fill in your key. Keep .env out of version control.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides
JARVIS_MODEL=gpt-5.4-mini
JARVIS_IMAGE_MODEL=gpt-image-2
JARVIS_TTS_MODEL=gpt-4o-mini-tts
JARVIS_STT_MODEL=gpt-4o-mini-transcribe
JARVIS_TTS_VOICE=onyx
JARVIS_VOICE=false

# In-app updates. Replace jarvissystem20324 with your GitHub account.
# 'latest' always resolves to the newest published release.
# Leave blank to disable update checks.
JARVIS_UPDATE_URL=https://github.com/jarvissystem20324/jarvis/releases/latest/download/update.json
