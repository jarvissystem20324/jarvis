# --- AI provider ----------------------------------------------------------
# JARVIS needs ONE of these keys to think. Both free options are genuinely
# free — a free account, no card, no payment. Pick either.
#
#   Google Gemini  https://aistudio.google.com/apikey     (free, best quality)
#   Groq           https://console.groq.com/keys          (free, fastest, also
#                                                          does speech-to-text)
#
# With both set, Gemini is tried first and Groq covers it if that fails.

GEMINI_API_KEY=
GROQ_API_KEY=

# Optional and paid. Only needed for OpenAI's own models and voices.
OPENAI_API_KEY=

# Pin one backend instead of trying each in turn.
# gemini | groq | openai | pollinations | auto
JARVIS_PROVIDER=auto

# Per-provider model overrides. Leave blank for the defaults; set one if a
# provider retires a model and JARVIS reports it can't be found.
JARVIS_GEMINI_MODEL=
JARVIS_GROQ_MODEL=
JARVIS_OPENAI_MODEL=

# --- images ---------------------------------------------------------------
# pollinations = free, no account, no key needed (the default)
# openai       = paid, better quality, needs OPENAI_API_KEY
# auto         = OpenAI when a key exists, otherwise Pollinations
JARVIS_IMAGE_PROVIDER=auto
JARVIS_IMAGE_MODEL=gpt-image-2

# --- voice ----------------------------------------------------------------
# Speech OUT works with no key at all using the built-in Windows voices.
# Speech IN needs either a free Groq key above, or faster-whisper installed
# locally (pip install faster-whisper) to transcribe fully offline.
# auto | groq | openai | local
JARVIS_STT_PROVIDER=auto

# Local Whisper size when using faster-whisper: tiny | base | small | medium
JARVIS_WHISPER_MODEL=base

# Paid OpenAI voices, used only when OPENAI_API_KEY is set.
JARVIS_TTS_MODEL=gpt-4o-mini-tts
JARVIS_TTS_VOICE=onyx
JARVIS_VOICE=false

# --- addons ---------------------------------------------------------------
# Global shortcut that brings the window to the front.
# Windows: on by default, no permission needed.
# macOS:   OFF unless you set it here. Watching for a shortcut system-wide
#          needs Accessibility permission (the same one a keylogger asks for),
#          so a fresh install requests nothing until you opt in. Example:
#          JARVIS_HOTKEY=cmd+shift+j
JARVIS_HOTKEY=ctrl+alt+j

# --- updates --------------------------------------------------------------
# 'latest' always resolves to the newest published release.
# Leave blank to disable update checks.
JARVIS_UPDATE_URL=https://github.com/jarvissystem20324/jarvis/releases/latest/download/update.json
